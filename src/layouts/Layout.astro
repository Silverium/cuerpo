---
import { canonicalUrl, href, stripBase, withSlash } from '../lib/paths';
import { getOtherApps } from '../lib/soldeplata';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const current = withSlash(Astro.url.pathname);
const canonical = canonicalUrl(stripBase(Astro.url.pathname));
const otherApps = await getOtherApps();

const links = [
  { path: 'imc/', label: 'IMC' },
  { path: 'agua/', label: 'Agua y electrolitos' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={href('sitemap.xml')} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href()}>
          <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="30" fill="currentColor"></circle><path d="M32 14c-6 9-12 16-12 23a12 12 0 0 0 24 0c0-7-6-14-12-23Z" fill="var(--bg)"></path></svg>
          Cuerpo
        </a>
        <nav aria-label="Calculadoras">
          {
            links.map((l) => (
              <a href={href(l.path)} aria-current={current === href(l.path) ? 'page' : undefined}>
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <p class="disclaimer">
        <strong>Aviso:</strong> no soy médico. Las recomendaciones de esta web se basan en estudios
        científicos y en lo que recomiendan algunos médicos y autores, pero no son consejo médico ni
        sustituyen la valoración de un profesional sanitario. Si decides seguirlas, lo haces bajo tu
        responsabilidad: declino toda responsabilidad por las consecuencias.
      </p>
      <p>
        Estimaciones orientativas basadas en fórmulas poblacionales. No sustituyen una valoración médica ni
        una medición por bioimpedancia o analítica.
      </p>
      <p>Tus datos se quedan en tu navegador (localStorage) y en la URL que decidas compartir.</p>
      <p class="more">
        <a href={href('sobre-mi/')}>Quién hace Cuerpo</a>
        {' · Más apps de Soldeplata: '}
        {
          otherApps.map((app, i) => (
            <>
              {i > 0 && ', '}
              <a href={app.url} target="_blank" rel="noopener" title={app.tagline}>
                {app.name}
              </a>
            </>
          ))
        }
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f6f2;
    --surface: #ffffff;
    --surface-2: #f0efe9;
    --text: #1c1b18;
    --muted: #6b6860;
    --border: #e2e0d8;
    --accent: #0f766e;
    --accent-soft: #ccfbf1;
    --ok: #15803d;
    --low: #ca8a04;
    --warn: #ea580c;
    --high: #dc2626;
    --ic: #0f766e;
    --is: #38bdf8;
    --pl: #a78bfa;
    --radius: 14px;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12130f;
      --surface: #1b1c18;
      --surface-2: #24251f;
      --text: #ecebe6;
      --muted: #a29f95;
      --border: #33342d;
      --accent: #2dd4bf;
      --accent-soft: #134e4a;
      --ok: #4ade80;
      --low: #facc15;
      --warn: #fb923c;
      --high: #f87171;
      --ic: #2dd4bf;
      --is: #38bdf8;
      --pl: #c4b5fd;
      color-scheme: dark;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  h2 {
    font-size: 1.2rem;
  }

  h3 {
    font-size: 1rem;
  }

  .wrap {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 60px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text);
    text-decoration: none;
  }

  .brand svg {
    width: 26px;
    height: 26px;
    color: var(--accent);
  }

  nav {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  .site-footer {
    color: var(--muted);
    font-size: 0.85rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--border);
    margin-top: 3rem;
  }

  .site-footer p {
    margin: 0.25rem 0;
  }

  .site-footer .disclaimer {
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .site-footer .more {
    margin-top: 1rem;
  }

  /* ── Página de calculadora ── */

  .page-head {
    padding: 2rem 0 1.25rem;
  }

  .page-head p {
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
  }

  .calc {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 820px) {
    .calc {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
  }

  form.card {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 821px) {
    form.card {
      position: sticky;
      top: 76px;
    }
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  legend {
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.25rem;
    padding: 0;
  }

  .field {
    display: grid;
    gap: 0.3rem;
  }

  .field > span,
  .label {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .input-unit {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    overflow: hidden;
  }

  .input-unit:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .input-unit input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    /* iOS Safari hace zoom al enfocar inputs con texto < 16px */
    font-size: 16px;
    padding: 0.55rem 0.7rem;
    outline: none;
  }

  .input-unit .unit {
    display: flex;
    align-items: center;
    padding: 0 0.7rem;
    color: var(--muted);
    font-size: 0.85rem;
    background: var(--surface-2);
  }

  .segmented {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--surface-2);
    border-radius: 10px;
    padding: 3px;
  }

  .segmented label {
    text-align: center;
    padding: 0.45rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .segmented input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .segmented label:has(input:checked) {
    background: var(--surface);
    color: var(--text);
    font-weight: 600;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }

  .segmented label:has(input:focus-visible) {
    outline: 2px solid var(--accent);
  }

  .check {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.9rem;
  }

  .check input {
    accent-color: var(--accent);
    width: 1.05rem;
    height: 1.05rem;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  button {
    font: inherit;
    font-size: 0.9rem;
    border-radius: 10px;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }

  button:hover {
    filter: brightness(0.96);
  }

  .hint {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  .empty {
    color: var(--muted);
    text-align: center;
    padding: 2.5rem 1rem;
  }

  /* ── Resultados ── */

  .big {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .big strong {
    font-size: clamp(2.6rem, 8vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .big .unit {
    color: var(--muted);
  }

  .badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone, var(--muted)) 16%, transparent);
    color: var(--tone, var(--muted));
  }

  [data-tone='ok'] {
    --tone: var(--ok);
  }
  [data-tone='low'] {
    --tone: var(--low);
  }
  [data-tone='warn'] {
    --tone: var(--warn);
  }
  [data-tone='high'] {
    --tone: var(--high);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
  }

  .stat {
    background: var(--surface-2);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }

  .stat .k {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .stat .v {
    font-size: 1.25rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .stat .s {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    text-align: right;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  thead th {
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 600;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  details summary {
    cursor: pointer;
    font-weight: 600;
  }

  .note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.75rem 0 0;
  }

  .hidden {
    display: none !important;
  }
</style>
